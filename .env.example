# ---- Required ----
APP_SECRET=                      # openssl rand -hex 32

# ---- Streaming tier (docs/MARKET-DATA.md): one WebSocket to a provider, fanned out to every tab at /ws ----
MARKET_STREAM=                   # alpaca | polygon (or massive) | empty = the GitHub feed only
ALPACA_KEY=                      # free account at alpaca.markets → real-time IEX stream (30 symbols), historical bars
ALPACA_SECRET=
ALPACA_FEED=iex                  # sip once you pay for the consolidated tape
# POLYGON_KEY=                   # Polygon / Massive: SIP on real-time plans; POLYGON_DELAYED=1 on the delayed plan (labelled "delayed")
# HOST=0.0.0.0                   # bind for a VPS (default 127.0.0.1)

# ---- Options chain provider: cboe (free, delayed, personal use) | tradier | polygon ----
DATA_PROVIDER=cboe
TRADIER_TOKEN=                   # https://developer.tradier.com  (TRADIER_ENV=sandbox gives free delayed chains)
TRADIER_ENV=sandbox
POLYGON_KEY=                     # https://polygon.io  (options plan; also enables real-time bars and the flow collector)
MAX_EXPIRATIONS=12
SEC_USER_AGENT=Your Name you@example.com   # required by the SEC for insider filings

# ---- Daily jobs ----
CRON_SECRET=                     # openssl rand -hex 16; Vercel sends it automatically on scheduled runs
DISCORD_WEBHOOK=                 # morning levels post + flow/level alerts from the terminal
MORNING_TICKERS=SPX,SPY,QQQ,IWM

# ---- Ask the desk / Ava ----
ANTHROPIC_API_KEY=
ASK_KEY=                         # required on a deployed server (not localhost): clients must send it; stops anonymous use of your Anthropic key
SITE_URL=

# ---- Flow tape ----
FLOW_SECRET=                     # shared with collector/flow-collector.mjs
BLOB_READ_WRITE_TOKEN=           # auto-set when you attach a Vercel Blob store (shares the tape across instances)

# Optional: a free FRED key (fred.stlouisfed.org → My Account → API Keys). The feed then refreshes the macro release calendar from FRED daily; without it the hand-verified calendar in data-static/ is used.
# FRED_API_KEY=

# ---- Running Kingnode as a server (Railway, Render, Fly, a VPS) ----
# The host sets PORT; the server then binds 0.0.0.0 and serves the feed's files at /data with no caching.
# FEED=1            run the feed loop inside the server (no GitHub Actions, no tokens); writes to ./data
# DATA_DIR=/data    a persistent volume for ./data so closes, levels history and snapshots survive a redeploy (Railway: add a Volume mounted at /data)
# ANTHROPIC_API_KEY=  Ava through the server — the key never reaches a browser
# ASK_KEY=            the password browsers must present for Ava and the proxied APIs on a public host (enter it in ⚙ Settings → Server access key)
# MODEL=claude-sonnet-5-5
# MARKET_STREAM=alpaca  ALPACA_KEY=  ALPACA_SECRET=   real-time quotes, bid × ask and bars (free IEX keys at alpaca.markets)
# WS_ORIGINS=https://edwinp2342.github.io            let the GitHub Pages copy open the stream too
# DATA_PROVIDER=tradier  TRADIER_TOKEN=               a real-time options chain (Tradier brokerage account, $10/month)
